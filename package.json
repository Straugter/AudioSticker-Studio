{
  "name": "audiosticker-stiksound-pwa",
  "version": "2.0.0",
  "private": true,
  "description": "AudioSticker Studio — Crea y envía Stickers con Sonido reales (WebP Animado + Ogg/Opus) para WhatsApp en Web, Chrome Extension y APK Android.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=app.bundle.js --minify",
    "build:www": "npm run build && node scripts/sync-www.js",
    "cap:sync": "npm run build:www && npx cap sync android",
    "start": "node server.js",
    "dev": "node server.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "fflate": "^0.8.2",
    "mp4-muxer": "^5.1.3",
    "webm-muxer": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
